generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum UserRole {
  USER
  ADMIN // полный доступ к админке
  SUPPORT // только просмотр (права см. admin.permissions.ts)
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  TELEGRAM
}

enum TokenType {
  PASSWORD_RESET
}

// Деньги везде храним целым числом в минимальных единицах:
// RUB — копейки, USD — центы, XTR — сами Stars.
enum Currency {
  RUB
  USD
  XTR // Telegram Stars
}

enum PaymentProvider {
  PLATEGA // СБП
  CRYPTO
  TELEGRAM_STARS
}

// Неудачная выдача подписки НЕ меняет статус заказа:
// заказ остаётся PAID, а проблема видна в FulfillmentJob.
enum OrderStatus {
  PENDING // ждём оплату
  PAID // оплачен, подписка ещё не выдана
  FULFILLED // подписка выдана/продлена в Remnawave
  EXPIRED // окно оплаты истекло
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED // ретраи исчерпаны, нужно вмешательство админа
}

// ─────────────────────── Пользователи и вход ───────────────────────

model User {
  id              String     @id @default(uuid())
  email           String?    @unique // lowercase, только подтверждённый
  emailVerifiedAt DateTime?
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)

  // Числовой id пользователя в Remnawave (в API 3.x пользователь адресуется по id или username).
  // null, пока ничего не куплено. Username у нас детерминированный (см. remnawave.username.ts).
  remnawaveUserId Int? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fulfillmentLease FulfillmentLease?
  identities    AuthIdentity[]
  sessions      Session[]
  totp          AdminTotp?
  recoveryCodes AdminRecoveryCode[]
  adminSessions AdminSession[]
  tokens     VerificationToken[]
  orders     Order[]
}

// Один способ входа = одна запись. Почта, Google и Telegram
// привязываются к одному User, поэтому аккаунты не дублируются.
model AuthIdentity {
  id           String       @id @default(uuid())
  userId       String
  provider     AuthProvider
  providerId   String // email (lowercase) / Google sub / Telegram user id
  passwordHash String? // только для EMAIL, argon2id
  verifiedAt   DateTime?
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@unique([userId, provider])
}

// Refresh-сессии. Сам токен не храним, только sha256-хэш.
// familyId нужен для ротации: если старый токен предъявлен повторно,
// отзываем всю цепочку.
model Session {
  id        String    @id @default(uuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  // revokedAt: токен больше не действует (ротация, выход, смена пароля, кража).
  // rotatedAt: токен погашен именно ротацией, только к такому применяется окно гонки двух вкладок.
  // Отозванный иначе (выход, кража) не имеет rotatedAt и отклоняется сразу.
  revokedAt DateTime?
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// Регистрация по почте: пользователь создаётся только ПОСЛЕ подтверждения ссылкой.
// Пока почта не подтверждена, аккаунта нет, поэтому чужой email нельзя «занять заранее»
// (pre-hijacking). Строк на один email может быть несколько: каждая ссылка
// создаёт аккаунт со своим паролем, и кликнуть её может только владелец ящика.
model PendingRegistration {
  id           String   @id @default(uuid())
  email        String // lowercase
  passwordHash String // argon2id
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

// Токены для сброса пароля (и будущих сценариев вроде смены почты).
model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ─────────────────────────── Админка ───────────────────────────

// Второй фактор админа (TOTP). Секрет хранится зашифрованным (AES-256-GCM).
model AdminTotp {
  id             String    @id @default(uuid())
  userId         String    @unique
  secretEnc      String
  confirmedAt    DateTime? // null, пока админ не подтвердил первый код
  lastUsedStep   Int? // последний принятый 30-секундный шаг: защита от повторного использования кода
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Одноразовые резервные коды на случай потери телефона. Хранится только хэш.
model AdminRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Серверные сессии админки (в куке лежит только случайный токен). Отзыв действует мгновенно.
model AdminSession {
  id            String    @id @default(uuid())
  userId        String
  tokenHash     String    @unique
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  idleExpiresAt DateTime // истекает при бездействии
  expiresAt     DateTime // абсолютный предел жизни сессии
  revokedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────── Тарифы ───────────────────────────
// Редактируются из админки. Plan = «уровень» (лимит устройств),
// PlanPrice = цена за срок в конкретной валюте.

model Plan {
  id          String  @id @default(uuid())
  code        String  @unique // "starter"
  name        String
  deviceLimit Int // стартовый: 5
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  prices PlanPrice[]
  orders Order[]
}

model PlanPrice {
  id             String   @id @default(uuid())
  planId         String
  durationMonths Int // 1, 3, 6
  currency       Currency
  amount         Int
  isActive       Boolean  @default(true)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, durationMonths, currency])
}

// ───────────────────── Заказы и платежи ─────────────────────

model Order {
  id     String @id @default(uuid())
  userId String
  planId String

  // Снапшот условий на момент создания: смена цен в админке
  // не должна задним числом менять старые заказы.
  durationMonths Int
  deviceLimit    Int
  currency       Currency
  amount         Int

  status      OrderStatus @default(PENDING)
  expiresAt   DateTime // конец окна оплаты
  paidAt      DateTime?
  fulfilledAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  plan     Plan            @relation(fields: [planId], references: [id])
  payments Payment[]
  job      FulfillmentJob?

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

// У заказа может быть несколько попыток оплаты (разные провайдеры).
model Payment {
  id           String          @id @default(uuid())
  orderId      String
  provider     PaymentProvider
  externalId   String? // id транзакции у провайдера
  status       PaymentStatus   @default(PENDING)
  amount       Int
  currency     Currency
  providerData Json?
  paidAt       DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@unique([provider, externalId])
  @@index([orderId])
}

// Журнал входящих вебхуков. Уникальный (provider, eventKey) —
// основа идемпотентности: повторная доставка упрётся в constraint.
model WebhookEvent {
  id             String          @id @default(uuid())
  provider       PaymentProvider
  eventKey       String // id события или хэш(externalId + status)
  payload        Json
  signatureValid Boolean
  receivedAt     DateTime        @default(now())
  processedAt    DateTime?
  error          String?

  @@unique([provider, eventKey])
}

// Outbox: оплата только создаёт задачу, а воркер ходит в Remnawave
// с ретраями. orderId unique => один заказ продлевает подписку ровно один раз.
model FulfillmentJob {
  id            String    @id @default(uuid())
  orderId       String    @unique
  status        JobStatus @default(PENDING)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  // Итоговая дата окончания подписки, вычисленная при первой попытке и сохранённая.
  // Запрос в Remnawave задаёт её абсолютным значением, поэтому повтор после сбоя безопасен
  // и срок не удлиняется дважды.
  targetExpireAt DateTime?
  lockedAt      DateTime?
  lastError     String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id])

  lease FulfillmentLease?

  @@index([status, nextAttemptAt])
}

// ─────────────────────────── Аудит ───────────────────────────

// Все действия админов (смена цен, ручное продление, блокировка).
// Связь с User намеренно не делаем: логи должны переживать удаление.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String // "plan.price.update", "order.refund" ...
  entity    String
  entityId  String?
  data      Json? // что изменилось
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

// One active slot per account, including across different orders.
model FulfillmentLease {
  userId     String @id
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation BigInt
  jobId      String? @unique
  job        FulfillmentJob? @relation(fields: [jobId], references: [id], onDelete: Restrict)
  owner      String?
  expiresAt  DateTime? @db.Timestamptz(3)
}
