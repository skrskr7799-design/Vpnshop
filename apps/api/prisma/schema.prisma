generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum UserRole {
  USER
  ADMIN // операционный доступ
  SUPPORT // ограниченный просмотр
  OWNER // управление персоналом и операционный доступ
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  TELEGRAM
}

enum TokenType {
  PASSWORD_RESET
  VERIFY_EMAIL
}

// Деньги везде храним целым числом в минимальных единицах:
// RUB — копейки, USD — центы, XTR — сами Stars.
enum Currency {
  RUB
  USD
  XTR // Telegram Stars
}

enum PaymentProvider {
  PLATEGA // СБП
  CRYPTO
  TELEGRAM_STARS
}

// Неудачная выдача подписки НЕ меняет статус заказа:
// заказ остаётся PAID, а проблема видна в FulfillmentJob.
enum OrderStatus {
  PENDING // ждём оплату
  PAID // оплачен, подписка ещё не выдана
  FULFILLED // подписка выдана/продлена в Remnawave
  EXPIRED // окно оплаты истекло
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  CREATED
  SUBMITTING
  AWAITING_CUSTOMER
  PROCESSING
  UNKNOWN
  SUCCEEDED
  CANCELED
}

enum MerchantEnvironment {
  MOCK
  SANDBOX
  PRODUCTION
}

enum MovementKind {
  CAPTURE
  REFUND
  CHARGEBACK_DEBIT
  CHARGEBACK_REVERSAL
  FEE
  ADJUSTMENT
}

enum PaymentEvidence {
  WEBHOOK
  LOOKUP
}

enum PaymentCaseStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED // legacy test failure
  CONFIRMED
  RETRY_WAIT
  VERIFY_PENDING
  NEEDS_REVIEW
  SUPERSEDED
}

// ─────────────────────── Пользователи и вход ───────────────────────

enum SubscriptionLinkPolicy {
  INHERIT
  ALLOW
  DENY
}

model User {
  subscriptionLinkPolicy SubscriptionLinkPolicy @default(INHERIT)
  id              String     @id @default(uuid())
  email           String?    @unique // lowercase, владение определяется emailVerifiedAt
  emailVerifiedAt DateTime?
  emailLoginDisabled Boolean @default(false)
  activationRequired Boolean @default(false)
  manualActivatedAt DateTime?
  displayName String?
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)

  // Числовой id пользователя в Remnawave (в API 3.x пользователь адресуется по id или username).
  // null, пока ничего не куплено. Username у нас детерминированный (см. remnawave.username.ts).
  remnawaveUserId Int? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fulfillmentLease FulfillmentLease?
  subscription Subscription?
  identities    AuthIdentity[]
  sessions      Session[]
  sessionFamilies SessionFamily[]
  totp          AdminTotp?
  recoveryCodes AdminRecoveryCode[]
  adminSessions AdminSession[]
  staffCredential StaffCredential?
  staffChallenges StaffChallenge[]
  staffResets StaffReset[]
  tokens     VerificationToken[]
  orders     Order[]
  supportCases SupportCase[]
  assignedCases SupportCase[] @relation("SupportAssignee")
  supportReads SupportReadCursor[]
  @@index([role, createdAt, id])
}

// Один способ входа = одна запись. Почта, Google и Telegram
// привязываются к одному User, поэтому аккаунты не дублируются.
model AuthIdentity {
  id           String       @id @default(uuid())
  userId       String
  provider     AuthProvider
  providerId   String // email (lowercase) / Google sub / Telegram user id
  passwordHash String? // только для EMAIL, argon2id
  temporaryPasswordExpiresAt DateTime?
  verifiedAt   DateTime?
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@unique([userId, provider])
}

// Refresh-сессии. Сам токен не храним, только sha256-хэш.
// familyId нужен для ротации: если старый токен предъявлен повторно,
// отзываем всю цепочку.
model Session {
  id        String    @id @default(uuid())
  userId    String
  familyId  String
  liveFamilyId String?
  family SessionFamily? @relation(fields: [liveFamilyId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  // revokedAt: токен больше не действует (ротация, выход, смена пароля, кража).
  // rotatedAt: токен погашен именно ротацией, только к такому применяется окно гонки двух вкладок.
  // Отозванный иначе (выход, кража) не имеет rotatedAt и отклоняется сразу.
  revokedAt DateTime?
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// Separate claims may exist for the same email. No claim can sign in.
model PendingRegistration {
  id           String   @id @default(uuid())
  email        String
  passwordHash String?  // Empty for an operator-created reservation
  tokenHash    String?  @unique
  approvalHash String?  // Digest of the claimant's manual approval reference
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

// Токены для сброса пароля (и будущих сценариев вроде смены почты).
model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  email     String?
  familyId  String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ─────────────────────────── Админка ───────────────────────────

// Второй фактор админа (TOTP). Секрет хранится зашифрованным (AES-256-GCM).
model AdminTotp {
  id             String    @id @default(uuid())
  userId         String    @unique
  secretEnc      String
  confirmedAt    DateTime? // null, пока админ не подтвердил первый код
  lastUsedStep   Int? // последний принятый 30-секундный шаг: защита от повторного использования кода
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Одноразовые резервные коды на случай потери телефона. Хранится только хэш.
model AdminRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Серверные сессии админки (в куке лежит только случайный токен). Отзыв действует мгновенно.
model AdminSession {
  id            String    @id @default(uuid())
  userId        String
  tokenHash     String    @unique
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  idleExpiresAt DateTime // истекает при бездействии
  expiresAt     DateTime // абсолютный предел жизни сессии
  revokedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  policy String @default("required")
  factorVerified Boolean @default(false)

  confirmations AdminConfirmation[]

  @@index([userId])
}

// ─────────────────────────── Тарифы ───────────────────────────
// Редактируются из админки. Plan = «уровень» (лимит устройств),
// PlanPrice = цена за срок в конкретной валюте.

model Plan {
  id          String  @id @default(uuid())
  code        String  @unique // "starter"
  name        String
  deviceLimit Int // стартовый: 5
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  revision    Int @default(0)
  createdAt   DateTime @default(now())

  prices PlanPrice[]
  orders Order[]

  @@index([createdAt, id])
}

model PlanPrice {
  id             String   @id @default(uuid())
  planId         String
  durationMonths Int // 1, 3, 6
  currency       Currency
  amount         Int
  isActive       Boolean  @default(true)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  versions OfferVersion[]

  @@unique([planId, durationMonths, currency])
}

// PlanPrice is the stable offer. Each publication freezes its commercial terms.
model OfferVersion {
  id             String   @id @default(uuid())
  planPriceId    String
  version        Int
  name           String
  durationMonths Int
  deviceLimit    Int
  currency       Currency
  amount         Int
  publishedAt    DateTime
  withdrawnAt    DateTime?

  offer  PlanPrice @relation(fields: [planPriceId], references: [id], onDelete: Restrict)
  orders Order[]

  @@unique([planPriceId, version])
}

// ───────────────────── Заказы и платежи ─────────────────────

model Order {
  id     String @id @default(uuid())
  userId String
  planId String

  // Снапшот условий на момент создания: смена цен в админке
  // не должна задним числом менять старые заказы.
  durationMonths Int
  deviceLimit    Int
  currency       Currency
  amount         Int

  offerVersionId String?
  checkoutKeyHash String?
  checkoutPolicyVersion Int?

  status      OrderStatus @default(PENDING)
  expiresAt   DateTime // конец окна оплаты
  paidAt      DateTime?
  fulfilledAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  plan     Plan            @relation(fields: [planId], references: [id])
  payments Payment[]
  job      FulfillmentJob?
  allocation OrderAllocation?
  period PeriodGrant?
  offerVersion OfferVersion? @relation(fields: [offerVersionId], references: [id], onDelete: Restrict)

  supportCases SupportCase[]

  @@unique([id, userId])
  @@unique([userId, checkoutKeyHash])
  @@index([offerVersionId])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([createdAt, id])
}

model MerchantAccount {
  id          String              @id @default(uuid())
  provider    PaymentProvider
  environment MerchantEnvironment
  merchant    String
  payments    Payment[]
  events      WebhookEvent[]
  ledger      PaymentTransaction[]
  cases       PaymentCase[]

  @@unique([provider, environment, merchant])
}

// A null account identifies a legacy attempt whose external proof has not been verified.
model Payment {
  id                String          @id @default(uuid())
  orderId           String
  provider          PaymentProvider
  externalId        String?
  status            PaymentStatus   @default(PENDING)
  amount            Int
  currency          Currency
  providerData      Json?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  accountId         String?
  merchantReference String?
  requestKeyHash    String?
  channel           String?
  expiresAt         DateTime?
  nextCheckAt       DateTime?
  reasonCode        String?
  redirectUrl       String?

  order   Order @relation(fields: [orderId], references: [id])
  account MerchantAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  ledger  PaymentTransaction[]

  @@unique([accountId, externalId])
  @@unique([accountId, merchantReference])
  @@unique([orderId, requestKeyHash])
  @@index([orderId])
  @@index([accountId, nextCheckAt])
}

// Managed payload is a sanitized, replayable observation. Legacy JSON is retained in place.
model WebhookEvent {
  id             String          @id @default(uuid())
  provider       PaymentProvider
  eventKey       String
  payload        Json
  signatureValid Boolean
  receivedAt     DateTime        @default(now())
  processedAt    DateTime?
  error          String?

  accountId      String?
  fingerprint    String?
  evidence       PaymentEvidence?
  nextCheckAt    DateTime?
  attempts       Int @default(0)

  account MerchantAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, eventKey])
  @@index([accountId, processedAt, nextCheckAt])
}

model PaymentTransaction {
  id                  String @id @default(uuid())
  accountId           String
  movementKey         String
  kind                MovementKind
  amountMinor         BigInt
  currency            String
  providerTime        DateTime?
  receivedAt          DateTime @default(now())
  evidence            PaymentEvidence
  externalPaymentId   String
  merchantReference   String?
  originalMovementKey String?
  paymentId           String?

  account MerchantAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  allocation OrderAllocation?
  refundIntents RefundIntent[]
  adjustment Adjustment?
  hold ServiceHold? @relation("HoldMovement")
  holdRelease ServiceHold? @relation("HoldReleaseMovement")

  @@unique([accountId, movementKey])
  @@index([accountId, originalMovementKey])
  @@index([accountId, externalPaymentId])
  @@index([accountId, merchantReference])
  @@index([paymentId])
  @@index([providerTime])
}

model PaymentCase {
  id          String @id @default(uuid())
  accountId   String
  objectKey   String
  kind        String
  reason      String
  status      PaymentCaseStatus @default(OPEN)
  priority    Int @default(1)
  nextCheckAt DateTime?
  details     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  history     Json @default("[]")

  account MerchantAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, objectKey, kind])
  @@index([status, nextCheckAt])
}

// Outbox: оплата только создаёт задачу, а воркер ходит в Remnawave
// с ретраями. orderId unique => один заказ продлевает подписку ровно один раз.
model FulfillmentJob {
  id            String    @id @default(uuid())
  orderId       String?   @unique
  assignmentId  String?   @unique
  verificationEpoch Int @default(0)
  writes        Int @default(0)
  status        JobStatus @default(PENDING)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  // Итоговая дата окончания подписки, вычисленная при первой попытке и сохранённая.
  // Запрос в Remnawave задаёт её абсолютным значением, поэтому повтор после сбоя безопасен
  // и срок не удлиняется дважды.
  targetExpireAt DateTime?
  lockedAt      DateTime?
  lastError     String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  assignment DesiredAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  lease FulfillmentLease?

  @@index([status, nextAttemptAt])
  @@index([createdAt, id])
}

// ─────────────────────────── Аудит ───────────────────────────

// Все действия админов (смена цен, ручное продление, блокировка).
// Связь с User намеренно не делаем: логи должны переживать удаление.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String // "plan.price.update", "order.refund" ...
  entity    String
  entityId  String?
  data      Json? // что изменилось
  ip        String?
  createdAt DateTime @default(now())

  role          String?
  permission    String?
  reason        String?
  commandId     String?
  correlationId String?
  outcome       String?

  @@index([createdAt, id])
  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

// One active slot per account, including across different orders.
model FulfillmentLease {
  userId     String @id
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation BigInt
  jobId      String? @unique
  job        FulfillmentJob? @relation(fields: [jobId], references: [id], onDelete: Restrict)
  owner      String?
  expiresAt  DateTime? @db.Timestamptz(3)
}

model OrderAllocation {
  id        String @id @default(uuid())
  orderId   String @unique
  captureId String @unique
  createdAt DateTime

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  capture PaymentTransaction @relation(fields: [captureId], references: [id], onDelete: Restrict)
  grant PeriodGrant?
}

model Subscription {
  id               String @id @default(uuid())
  userId           String @unique
  legacyUnverified Boolean @default(false)
  revision         Int @default(0)
  createdAt        DateTime @default(now())
  nextBoundaryAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  periods PeriodGrant[]
  holds ServiceHold[]
  assignments DesiredAssignment[]
  panelBinding PanelBinding?

  @@index([nextBoundaryAt])
  @@index([createdAt, id])
}

model PeriodGrant {
  id              String @id @default(uuid())
  subscriptionId  String
  orderId         String? @unique
  allocationId    String? @unique
  serial          Int
  startAt         DateTime
  endAt           DateTime
  createdAt       DateTime
  calendarVersion Int
  deviceLimit     Int

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  allocation OrderAllocation? @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  adjustment Adjustment?
  assignments DesiredAssignment[]

  incidentId String?
  basisGrantId String?
  compensationReason String?
  basis PeriodGrant? @relation("ServiceCompensation", fields: [basisGrantId, subscriptionId], references: [id, subscriptionId], onDelete: Restrict)
  compensations PeriodGrant[] @relation("ServiceCompensation")

  @@unique([id, subscriptionId])
  @@unique([subscriptionId, incidentId])
  @@unique([subscriptionId, serial])
}

model Adjustment {
  id          String @id @default(uuid())
  grantId     String @unique
  movementId  String @unique
  effectiveAt DateTime
  createdAt   DateTime
  reason      String

  grant PeriodGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)
  movement PaymentTransaction @relation(fields: [movementId], references: [id], onDelete: Restrict)
}

model ServiceHold {
  id                String @id @default(uuid())
  subscriptionId    String
  source            String
  kind              String
  reason            String
  createdAt         DateTime
  createdBy         String?
  movementId        String? @unique
  releasedAt        DateTime?
  releasedBy        String?
  releaseMovementId String? @unique

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  movement PaymentTransaction? @relation("HoldMovement", fields: [movementId], references: [id], onDelete: Restrict)
  releaseMovement PaymentTransaction? @relation("HoldReleaseMovement", fields: [releaseMovementId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, source])
}

model DesiredAssignment {
  id             String @id @default(uuid())
  subscriptionId String
  revision       Int
  grantId        String?
  enabled        Boolean
  deviceLimit    Int?
  expiresAt      DateTime?
  nextBoundaryAt DateTime?
  internalSquads String[] @default([])
  reason         String
  createdAt      DateTime

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  grant PeriodGrant? @relation(fields: [grantId], references: [id], onDelete: Restrict)
  job FulfillmentJob?
  observations PanelObservation[]

  @@unique([subscriptionId, revision])
}

model PanelBinding {
  subscriptionId String @id
  panelInstance String
  origin String
  username String
  marker String
  remoteUserId BigInt?
  createDispatched Boolean @default(false)
  disabledByShop Boolean @default(false)
  blockedReason String?
  confirmedRevision Int?
  confirmedAt DateTime?
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([panelInstance, username])
  @@unique([panelInstance, remoteUserId])
}

model PanelObservation {
  id String @id @default(uuid())
  assignmentId String
  panelInstance String
  revision Int
  remoteUserId BigInt?
  status String?
  expiresAt DateTime?
  deviceLimit Int?
  squads String[] @default([])
  observedAt DateTime
  receivedAt DateTime @default(now())
  owner String
  generation BigInt
  comparison String

  assignment DesiredAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([assignmentId, receivedAt])
}

model SessionFamily {
  loginMethod AuthProvider?
  id         String @id
  userId     String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens Session[]
  flows OAuthFlow[]
  proofs IdentityProof[]

  @@index([userId, revokedAt, expiresAt])
}

model OAuthFlow {
  state String @id
  provider String
  browserHash String
  verifier String
  nonce String?
  returnTo String?
  mode String
  familyId String?
  target AuthProvider?
  purpose String?
  requestKeyHash String?
  fingerprint String?
  proofId String?
  expiresAt DateTime
  consumedAt DateTime?
  family SessionFamily? @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, provider, requestKeyHash])
  @@index([expiresAt])
}

model IdentityProof {
  id String @id @default(uuid())
  familyId String
  target AuthProvider
  purpose String
  expiresAt DateTime
  usedAt DateTime?
  family SessionFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, expiresAt])
}

model AuthMailWindow {
  key String @id
  startedAt DateTime
  count Int
}

enum SupportCategory {
  PAYMENT
  DELIVERY
  ACCESS
  OTHER
  GENERAL
  SUBSCRIPTION
  TECHNICAL
  ACCOUNT
}

enum SupportStatus {
  OPEN
  WAITING_CUSTOMER
  RESOLVED
  IN_PROGRESS
  CLOSED
}

enum SupportAuthor {
  CUSTOMER
  STAFF
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportCase {
  id             String          @id @default(uuid())
  userId         String
  orderId        String?
  subject        String?
  assigneeId     String?
  priority       SupportPriority @default(NORMAL)
  category       SupportCategory
  status         SupportStatus   @default(OPEN)
  requestKeyHash String
  fingerprint    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  order    Order?           @relation(fields: [orderId, userId], references: [id, userId], onDelete: Restrict)
  assignee User? @relation("SupportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages SupportMessage[]
  events   SupportEvent[]
  reads    SupportReadCursor[]

  @@unique([userId, requestKeyHash])
  @@index([userId, createdAt, id])
  @@index([status, createdAt, id])
  @@index([orderId])
  @@index([assigneeId, createdAt, id])
}

model SupportMessage {
  id             String        @id @default(uuid())
  caseId         String
  author         SupportAuthor
  actorId        String?
  text           String
  requestKeyHash String?
  createdAt      DateTime      @default(now())

  ticket SupportCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([caseId, requestKeyHash])
  @@index([caseId, createdAt, id])
}

model SupportEvent {
  id             String        @id @default(uuid())
  caseId         String
  author         SupportAuthor
  fromStatus     SupportStatus
  customerVisible Boolean @default(true)
  toStatus       SupportStatus
  requestKeyHash String?
  fingerprint    String?
  reason         String?
  createdAt      DateTime      @default(now())

  ticket SupportCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([caseId, requestKeyHash])
  @@index([caseId, createdAt, id])
}

model SupportReadCursor {
  caseId    String
  readerId  String
  seenAt    DateTime

  ticket SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reader User @relation(fields: [readerId], references: [id], onDelete: Cascade)

  @@id([caseId, readerId])
  @@index([readerId])
}

model StaffCredential {
  userId       String @id
  username     String @unique
  displayName  String?
  contactEmail String?
  temporaryUntil DateTime?
  lastLoginAt DateTime?
  deactivatedAt DateTime?
  passwordHash String
  version      Int @default(1)
  user         User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model StaffChallenge {
  id           String @id
  userId       String
  version      Int
  stage        String
  policy       String @default("required")
  expiresAt    DateTime
  consumedAt   DateTime?
  user         User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}

model StaffInvite {
  issuedBy   String?
  id         String @id @default(uuid())
  email      String
  role       UserRole
  tokenHash  String @unique
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([email, expiresAt])
}

model StaffReset {
  id         String @id @default(uuid())
  userId     String
  actorId    String
  version    Int
  caseId     String
  expiresAt  DateTime
  approvedBy String?
  user       User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}

model AdminConfirmation {
  id          String @id @default(uuid())
  sessionId   String
  fingerprint String
  version     Int
  expiresAt   DateTime
  consumedAt  DateTime?
  session     AdminSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, expiresAt])
}

model AdminCommand {
  id          String @id @default(uuid())
  actorId     String
  operation   String
  permission  String
  targetId    String
  keyHash     String
  fingerprint String
  result      Json
  createdAt   DateTime @default(now())

  @@unique([actorId, operation, targetId, keyHash])
}

model WorkerHeartbeat {
  id         String @id
  observedAt DateTime
  ready      Boolean

  @@index([observedAt])
}

model RefundIntent {
  id          String @id @default(uuid())
  captureId   String
  commandId   String @unique
  initiatorId String
  approvedBy  String?
  approvedAt  DateTime?
  amountMinor BigInt
  currency    String
  reason      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  capture     PaymentTransaction @relation(fields: [captureId], references: [id], onDelete: Restrict)

  @@index([captureId, expiresAt])
  @@index([createdAt, id])
}

model AdminOperationalSettings {
  subscriptionLinkAllowed Boolean @default(true)
  twoFactorPolicy String?
  id                       String @id
  version                  Int @default(0)
  fulfillmentLagWarnSeconds Int @default(900)
  paymentLagWarnSeconds     Int @default(900)
}

model NotificationOutbox {
  id          String   @id @default(uuid())
  payload     String
  expiresAt   DateTime
  dueAt       DateTime @default(now())
  leaseId     String?
  leaseUntil  DateTime?
  attempts    Int      @default(0)

  @@index([dueAt])
}
