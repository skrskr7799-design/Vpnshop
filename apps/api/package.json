{
  "name": "@vpn/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup",
    "dev:worker": "tsx watch --env-file=../../.env src/worker.ts",
    "start:worker": "node dist/worker.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "test": "vitest run",
    "test:contract": "vitest run .contract.test.ts",
    "remnawave:staging-smoke": "tsx scripts/remnawave-staging-smoke.ts",
    "remnawave:check": "tsx --env-file=../../.env scripts/remnawave-check.ts",
    "test:integration": "bash scripts/integration/run.sh",
    "db:deploy": "prisma migrate deploy",
    "admin:create": "tsx --env-file=../../.env scripts/admin-create.ts",
    "admin:reset-2fa": "tsx --env-file=../../.env scripts/admin-reset-2fa.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.0",
    "@vpn/shared": "workspace:*",
    "fastify": "^5.0.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.17",
    "nodemailer": "^10.6.0",
    "otpauth": "^9.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@remnawave/backend-contract": "3.4.17",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.19.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
