# Operator settings. The V2 preflight resolves release and runtime settings separately.
MZT_DEPLOY_ENV=production
PUBLIC_HOST=
PUBLIC_BIND_IP=127.0.0.1
PUBLIC_TLS_PORT=443
PUBLIC_ORIGIN=
ADMIN_HOSTNAME=
ADMIN_ORIGIN=
ADMIN_BIND_IP=
ADMIN_CLIENT_CIDRS=
ADMIN_TLS_PORT=443
ADMIN_ACCESS_MODE=private
ADMIN_2FA_POLICY=required
ADMIN_SESSION_HOURS=12
ADMIN_IDLE_MINUTES=30
CHECKOUT_TTL_MINUTES=30

MZT_ENABLE_SMTP_EGRESS=0
MAIL_FROM=
MZT_ENABLE_OAUTH_EGRESS=0
GOOGLE_AUTH_ENABLED=false
TELEGRAM_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
TELEGRAM_CLIENT_ID=
TELEGRAM_OIDC_VERIFIED=false

MZT_ENABLE_PANEL_EGRESS=0
REMNAWAVE_REVISION_MODE=off
REMNAWAVE_STAGING_ORIGIN=
REMNAWAVE_STAGING_LINK_ORIGIN=
REMNAWAVE_STAGING_INSTANCE=
REMNAWAVE_STAGING_SQUADS=
# Live panel settings are reserved for PASS 05: REMNAWAVE_URL,
# REMNAWAVE_INTERNAL_SQUAD_UUIDS, REMNAWAVE_TRUSTED_PROXY_HEADERS (default false).

MZT_ENABLE_LOCAL_BACKUP=1
MZT_ENABLE_OFFSITE=0
LOGICAL_S3_ENDPOINT=
LOGICAL_S3_BUCKET=
LOGICAL_S3_REGION=
LOGICAL_KEY_VERSION=
BACKUP_MONITOR=false
PANEL_MONITOR=false
ALERTMANAGER_CONFIG=

# Runtime product settings (Core is authoritative for the storefront).
BRAND_NAME=MZT
SUPPORT_EMAIL=
SUPPORT_URL=
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=
LEGAL_REFUND_URL=
REGISTRATION_ENABLED=true
SUPPORT_ENABLED=true
MAINTENANCE_MODE=false
PAYMENTS_ENABLED=false
REMNAWAVE_ENABLED=false
LOG_LEVEL=info
