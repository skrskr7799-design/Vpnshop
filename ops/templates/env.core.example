# Operator settings. The V2 preflight resolves release and runtime settings separately.
MZT_DEPLOY_ENV=production
PUBLIC_ORIGIN=
ADMIN_HOSTNAME=
ADMIN_ORIGIN=
ADMIN_BIND_IP=
ADMIN_CLIENT_CIDRS=
ADMIN_TLS_PORT=443
ADMIN_ACCESS_MODE=private
ADMIN_SESSION_HOURS=12
ADMIN_IDLE_MINUTES=30
CHECKOUT_TTL_MINUTES=30

MZT_ENABLE_SMTP_EGRESS=0
MAIL_FROM=
MZT_ENABLE_OAUTH_EGRESS=0
GOOGLE_CLIENT_ID=
TELEGRAM_CLIENT_ID=
TELEGRAM_OIDC_VERIFIED=false

MZT_ENABLE_PANEL_EGRESS=0
REMNAWAVE_REVISION_MODE=off
REMNAWAVE_STAGING_ORIGIN=
REMNAWAVE_STAGING_LINK_ORIGIN=
REMNAWAVE_STAGING_INSTANCE=
REMNAWAVE_STAGING_SQUADS=
# Live panel settings are reserved for PASS 05: REMNAWAVE_URL,
# REMNAWAVE_INTERNAL_SQUAD_UUIDS, REMNAWAVE_TRUSTED_PROXY_HEADERS (default false).

MZT_ENABLE_LOCAL_BACKUP=0
MZT_ENABLE_OFFSITE=0
LOGICAL_S3_ENDPOINT=
LOGICAL_S3_BUCKET=
LOGICAL_S3_REGION=
LOGICAL_KEY_VERSION=
BACKUP_MONITOR=false
PANEL_MONITOR=false
ALERTMANAGER_CONFIG=

LINK_MODE=private
# Public link only. TLS server name in the Core certificate.
CORE_API_HOST=
CORE_LISTEN_IP=
# Empty selects 3000 for private or 8443 for public.
CORE_API_PORT=
EDGE_PEER_IP=
CORE_API_ALLOWED_IP=
# Private link only, when Docker changes the source IP. Enter the observed exact address.
CORE_PROXY_PEER_IP=
