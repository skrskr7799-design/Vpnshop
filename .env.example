# --- API ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://vpnshop:vpnshop@localhost:5432/vpnshop
# Origin публичного фронта (CORS + ссылки в письмах)
WEB_ORIGIN=http://localhost:5173
# Минимум 32 символа: openssl rand -base64 48
COOKIE_SECRET=change-me-change-me-change-me-change-me
# Отдельный секрет для access-токенов, тоже минимум 32 символа
JWT_SECRET=change-me-change-me-change-me-change-me

# --- Почта ---
# В dev можно оставить пустым: письма (со ссылками) будут выводиться в лог API
SMTP_URL=
MAIL_FROM="VPN Shop <no-reply@example.com>"

# --- Вход через Google (необязательно) ---
# Google Cloud Console -> Credentials -> OAuth client (Web application).
# Authorized redirect URI: <WEB_ORIGIN>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Вход через Telegram (необязательно) ---
# @BotFather -> бот -> Login Widget. Allowed URL: <WEB_ORIGIN>/api/auth/oauth/telegram/callback
# Client ID и Client Secret BotFather показывает там же.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# --- Админка (отдельный сервер, по умолчанию выключен) ---
ADMIN_ENABLED=false
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3001
# Точные IP/CIDR доверенных прокси через запятую. Пусто при прямом подключении.
ADMIN_TRUSTED_PROXIES=
ADMIN_ORIGIN=http://localhost:5174
# Разрешённые сети через запятую, например 100.64.0.0/10,10.0.0.0/8 (пусто = без ограничения)
ADMIN_ALLOWED_CIDRS=
# openssl rand -base64 32 (нужен, если ADMIN_ENABLED=true)
ADMIN_ENCRYPTION_KEY=
ADMIN_SESSION_HOURS=12
ADMIN_IDLE_MINUTES=30

# Окно оплаты нового заказа (минуты)
CHECKOUT_TTL_MINUTES=30

# --- Воркер выдачи подписок ---
# Отдельный процесс. При нескольких процессах на одном хосте укажите разные loopback-порты.
WORKER_HEALTH_PORT=3002
WORKER_LEASE_MS=90000
WORKER_HTTP_TIMEOUT_MS=20000
WORKER_DRAIN_MS=55000

# --- Remnawave ---
# Адрес панели и API-токен (Panel -> API Tokens)
REMNAWAVE_URL=https://panel.example.com
REMNAWAVE_TOKEN=change-me
# X-Api-Key, если панель закрыта Caddy с ключами доступа (необязательно)
REMNAWAVE_API_KEY=
# true, если API ходит к панели напрямую по внутренней сети (http://remnawave:3000), мимо её reverse proxy
REMNAWAVE_TRUSTED_PROXY_HEADERS=false
# Internal squads для новых пользователей, UUID через запятую (Panel -> Internal Squads)
REMNAWAVE_INTERNAL_SQUAD_UUIDS=00000000-0000-4000-8000-000000000000

# COM-04 defaults to local-only fulfillment. The staging mode uses separate variables.
REMNAWAVE_REVISION_MODE=off
# REMNAWAVE_STAGING_ORIGIN=https://isolated-panel.example.invalid
# REMNAWAVE_STAGING_LINK_ORIGIN=https://isolated-links.example.invalid
# REMNAWAVE_STAGING_INSTANCE=staging-isolated
# REMNAWAVE_STAGING_TOKEN is injected from the staging secret store
# REMNAWAVE_STAGING_API_KEY is optional and injected from the staging secret store
# REMNAWAVE_STAGING_SQUADS=11111111-1111-4111-8111-111111111111

# Exact reverse proxy IPs/CIDRs. Empty means direct connections only.
WEB_TRUSTED_PROXIES=
# Keep Telegram disabled until the issued OIDC claims are verified on staging.
TELEGRAM_OIDC_VERIFIED=false
